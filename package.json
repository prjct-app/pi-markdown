{
  "name": "@prjct-app/pi-minimalist-markdown",
  "version": "0.1.0",
  "description": "Display-only Markdown normalization for the Pi coding agent",
  "type": "module",
  "keywords": ["pi-package", "pi", "markdown", "terminal"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/prjct-app/pi-minimalist-markdown.git" },
  "homepage": "https://github.com/prjct-app/pi-minimalist-markdown#readme",
  "bugs": { "url": "https://github.com/prjct-app/pi-minimalist-markdown/issues" },
  "publishConfig": { "access": "public" },
